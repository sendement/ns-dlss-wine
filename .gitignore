# everything that is not source: runtime files, build outputs, third-party clones, caches
/runtime/
/third_party/
__pycache__/
*.pyc
*.so
*.exe
*.dll
*.o
*.a
*.cache
/hyprplug/build/
/hyprplug/nested/*.log
/hyprplug/nested/*.out
/hyprplug/nested/sig
# generated by shim/gen.py
/shim/pe_stubs.c
/shim/unix_side.c
/shim/nvcuda.def
/shim/nvcuda_fwd.def
# the user's own proprietary files (see user_files/README.md)
/user_files/*
!/user_files/README.md
!/user_files/.gitignore
/modules/
